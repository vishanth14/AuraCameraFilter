<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="76dp"
    android:layout_height="100dp"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingHorizontal="4dp">

    <!-- Thumbnail container with selection ring -->
    <FrameLayout
        android:layout_width="62dp"
        android:layout_height="62dp">

        <!-- Selection ring (visible when selected) -->
        <View
            android:id="@+id/view_ring"
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:background="@drawable/ring_selected"
            android:visibility="invisible" />

        <!-- Filter preview thumbnail -->
        <ImageView
            android:id="@+id/iv_thumb"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            android:background="@drawable/thumb_shape" />

    </FrameLayout>

    <!-- Filter name label -->
    <TextView
        android:id="@+id/tv_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textColor="#BBCCCCCC"
        android:textSize="10sp"
        android:letterSpacing="0.06"
        android:fontFamily="sans-serif"
        android:maxLines="1" />

</LinearLayout>
